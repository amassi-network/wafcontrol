server {
    listen @@PUBLIC_IP@@:@@ADMIN_PORT@@ ssl;
    @@PUBLIC_IPV6_LISTEN@@
    server_name @@DOMAIN@@;

    ssl_certificate /etc/letsencrypt/live/@@CERT_NAME@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@CERT_NAME@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:wafcontrol_tls:5m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    @@ADMIN_ALLOW_RULES@@
    deny all;

    server_tokens off;
    client_max_body_size 1m;

    access_log /var/log/nginx/wafcontrol_access.log;
    error_log /var/log/nginx/wafcontrol_error.log;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cache-Control "no-store" always;

    location /static/ {
        alias @@APP_ROOT@@/staticfiles/;
        autoindex off;
    }

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_pass http://unix:/run/wafcontrol/gunicorn.sock;
    }
}
